{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResourceFeature",
  "description": "Schema for geographic nodes and edges representing resource infrastructure in 'The World\\'s Resources'.",
  "type": "object",
  "required": ["type", "geometry", "properties"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["Feature"]
    },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Point", "LineString", "MultiLineString"]
        },
        "coordinates": {
          "type": "array"
        }
      }
    },
    "properties": {
      "type": "object",
      "required": ["id", "name", "resource", "category", "type", "summary", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "resource": {
          "type": "string",
          "enum": ["crude_oil", "natural_gas", "hydrogen", "copper", "lithium", "gold", "water"]
        },
        "category": {
          "type": "string",
          "enum": ["node", "edge"]
        },
        "type": {
          "type": "string",
          "enum": [
            "import_hub",
            "extraction_site",
            "processing_hub",
            "storage_hub",
            "pipeline",
            "shipping_route",
            "rail_corridor"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["operational", "planned", "under_expansion", "decommissioned"],
          "default": "operational"
        },
        "country": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "capacity": {
          "type": "string"
        },
        "length_km": {
          "type": "number"
        },
        "flow_direction": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "consumer_products": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supply_chain_stage": {
          "type": "string",
          "enum": ["extraction", "import", "transport", "processing", "distribution", "consumer"]
        },
        "aha_moment": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "explanation": { "type": "string" },
            "everyday_impact": { "type": "string" }
          }
        },
        "source": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string" },
            "year": { "type": "integer" }
          }
        }
      }
    }
  }
}
