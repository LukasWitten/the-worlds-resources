{
  "metadata": {
    "description": "Catalogue of goods shown on the map. A good is a raw material, an intermediate or a final product. The resource views (export, import, resource) use the goods with stage \"raw\". Every \"resource\" value in the GeoJSON datasets must be an id from this file.",
    "license": "CC-BY-4.0",
    "version": "1.2.0",
    "last_updated": "2026-11-23",
    "notes": {
      "stage": "raw = extracted or first-processed commodity as counted by USGS (crude oil, ore concentrate, lithium carbonate); intermediate = input for further production; final = product for end use.",
      "hs": "Harmonized System codes used to match trade statistics. precision: exact = the codes cover the good and nothing else; partial = some trade of the good is missing or mixed with other goods; none = no HS code isolates the good.",
      "style": "color = main map colour of the good; icon = emoji in badges; processing_icon = emoji on processing plants (defaults to icon); route_colors = colour overrides per route type (defaults to color)."
    }
  },
