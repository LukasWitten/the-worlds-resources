{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://theworldsresources.org/data/schemas/countries.schema.json",
  "title": "Countries",
  "description": "Country master data (public/data/reference/countries.json), generated by scripts/pipeline/build-countries.js. Validated by scripts/validate-data.js.",
  "type": "object",
  "required": ["metadata", "countries"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "countries": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z]{2}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["iso3", "m49", "baci", "name", "region", "subregion", "anchor"],
        "additionalProperties": false,
        "properties": {
          "iso3": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "m49": { "type": ["string", "null"], "pattern": "^[0-9]{3}$" },
          "baci": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "region": { "type": ["string", "null"] },
          "subregion": { "type": ["string", "null"] },
          "anchor": {
            "description": "[lon, lat] of the label point, or null if there is no shape for the territory.",
            "oneOf": [
              { "type": "null" },
              {
                "type": "array",
                "items": [
                  { "type": "number", "minimum": -180, "maximum": 180 },
                  { "type": "number", "minimum": -90, "maximum": 90 }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            ]
          }
        }
      }
    }
  }
}
