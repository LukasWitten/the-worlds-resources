{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://theworldsresources.org/data/schemas/goods.schema.json",
  "title": "GoodsCatalogue",
  "description": "Catalogue of goods (public/data/reference/goods.json). Validated by scripts/validate-data.js.",
  "type": "object",
  "required": ["metadata", "goods"],
  "definitions": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "good": {
      "type": "object",
      "required": ["label", "stage", "category", "unit", "style"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["raw", "intermediate", "final"] },
        "category": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "parent": {
          "description": "Id of a broader good this one belongs to (e.g. copper_ore → copper).",
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "hs": {
          "type": "object",
          "required": ["precision"],
          "additionalProperties": false,
          "properties": {
            "rev": { "enum": ["HS12", "HS17", "HS22"] },
            "codes": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9]{4}([0-9]{2})?$" },
              "uniqueItems": true
            },
            "precision": { "enum": ["exact", "partial", "none"] },
            "note": { "type": "string" }
          }
        },
        "unit": { "type": "string", "minLength": 1 },
        "style": {
          "type": "object",
          "required": ["color", "icon"],
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/definitions/color" },
            "icon": { "type": "string", "minLength": 1 },
            "processing_icon": { "type": "string", "minLength": 1 },
            "route_colors": {
              "type": "object",
              "propertyNames": { "enum": ["pipeline", "shipping_route", "rail_corridor"] },
              "additionalProperties": { "$ref": "#/definitions/color" }
            }
          }
        }
      }
    }
  },
  "properties": {
    "metadata": { "type": "object" },
    "goods": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": { "$ref": "#/definitions/good" }
    }
  }
}
