{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://theworldsresources.org/data/schemas/trade.schema.json",
  "title": "TradeData",
  "description": "Files in public/data/trade/<year>/, generated by scripts/pipeline/build-trade.js. One definition per file type; validated by scripts/validate-data.js.",
  "definitions": {
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "good": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "share": { "type": "number", "minimum": 0, "maximum": 1 },
    "usd": { "type": "integer", "minimum": 0 },
    "qty": { "type": ["number", "null"], "minimum": 0 },
    "year": { "type": "integer", "minimum": 1995, "maximum": 2100 },
    "rank": { "type": ["integer", "null"], "minimum": 1 },
    "provenance": {
      "type": "object",
      "required": ["kind", "sourceId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["observed", "modelled", "curated"] },
        "sourceId": { "type": "string" }
      }
    },
    "rankingYears": { "type": "array", "items": { "$ref": "#/definitions/year" }, "minItems": 1 },

    "meta": {
      "type": "object",
      "required": ["year", "rankingYears", "provenance", "hsRev", "units", "minFlowUsd", "selection", "goods", "countries"],
      "properties": {
        "year": { "$ref": "#/definitions/year" },
        "rankingYears": { "$ref": "#/definitions/rankingYears" },
        "provenance": { "$ref": "#/definitions/provenance" },
        "hsRev": { "enum": ["HS12", "HS17", "HS22"] },
        "units": { "type": "object" },
        "minFlowUsd": { "$ref": "#/definitions/usd" },
        "selection": { "type": "object" },
        "goods": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/good" },
          "additionalProperties": {
            "type": "object",
            "required": ["worldUsd", "worldQty", "exporters", "importers", "rows"],
            "properties": {
              "worldUsd": { "$ref": "#/definitions/usd" },
              "worldQty": { "$ref": "#/definitions/qty" },
              "exporters": { "type": "integer", "minimum": 0 },
              "importers": { "type": "integer", "minimum": 0 },
              "rows": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "countries": { "type": "array", "items": { "$ref": "#/definitions/country" } }
      }
    },

    "world": {
      "type": "object",
      "required": ["meta", "countries"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["year", "provenance", "rankingYears"],
          "properties": {
            "year": { "$ref": "#/definitions/year" },
            "provenance": { "$ref": "#/definitions/provenance" },
            "rankingYears": { "$ref": "#/definitions/rankingYears" }
          }
        },
        "countries": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/country" },
          "additionalProperties": {
            "type": "object",
            "required": ["export", "import"],
            "additionalProperties": false,
            "properties": {
              "export": { "$ref": "#/definitions/markerList" },
              "import": { "$ref": "#/definitions/markerList" }
            }
          }
        }
      }
    },
    "markerList": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["good", "score", "leader"],
        "additionalProperties": false,
        "properties": {
          "good": { "$ref": "#/definitions/good" },
          "score": { "$ref": "#/definitions/share" },
          "leader": { "type": "boolean" }
        }
      }
    },

    "byGood": {
      "type": "object",
      "required": ["meta", "columns", "rows"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["good", "year", "provenance", "minFlowUsd", "worldUsd", "worldQty"],
          "properties": {
            "good": { "$ref": "#/definitions/good" },
            "year": { "$ref": "#/definitions/year" },
            "provenance": { "$ref": "#/definitions/provenance" },
            "minFlowUsd": { "$ref": "#/definitions/usd" },
            "worldUsd": { "$ref": "#/definitions/usd" },
            "worldQty": { "$ref": "#/definitions/qty" }
          }
        },
        "columns": { "const": ["from", "to", "valueUsd", "qty"] },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              { "$ref": "#/definitions/country" },
              { "$ref": "#/definitions/country" },
              { "$ref": "#/definitions/usd" },
              { "$ref": "#/definitions/qty" }
            ],
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },

    "byCountry": {
      "type": "object",
      "required": ["meta", "totals", "top", "exports", "imports"],
      "properties": {
        "meta": {
          "type": "object",
          "required": ["country", "year", "provenance", "rankingYears"],
          "properties": {
            "country": { "$ref": "#/definitions/country" },
            "year": { "$ref": "#/definitions/year" },
            "provenance": { "$ref": "#/definitions/provenance" },
            "rankingYears": { "$ref": "#/definitions/rankingYears" }
          }
        },
        "totals": {
          "type": "object",
          "required": ["exportUsd", "importUsd"],
          "properties": {
            "exportUsd": { "$ref": "#/definitions/usd" },
            "importUsd": { "$ref": "#/definitions/usd" }
          }
        },
        "top": {
          "type": "object",
          "required": ["export", "import"],
          "properties": {
            "export": { "type": "array", "maxItems": 3, "items": { "$ref": "#/definitions/good" } },
            "import": { "type": "array", "maxItems": 3, "items": { "$ref": "#/definitions/good" } }
          }
        },
        "exports": { "type": "array", "items": { "$ref": "#/definitions/goodProfile" } },
        "imports": { "type": "array", "items": { "$ref": "#/definitions/goodProfile" } }
      }
    },
    "goodProfile": {
      "type": "object",
      "required": ["good", "valueUsd", "N", "G", "rank", "avg", "score", "leader", "qty", "partnerCount", "hhi", "partners"],
      "additionalProperties": false,
      "properties": {
        "good": { "$ref": "#/definitions/good" },
        "valueUsd": { "$ref": "#/definitions/usd" },
        "N": { "$ref": "#/definitions/share" },
        "G": { "$ref": "#/definitions/share" },
        "rank": { "$ref": "#/definitions/rank" },
        "avg": {
          "type": "object",
          "required": ["valueUsd", "N", "G", "rank"],
          "additionalProperties": false,
          "properties": {
            "valueUsd": { "$ref": "#/definitions/usd" },
            "N": { "$ref": "#/definitions/share" },
            "G": { "$ref": "#/definitions/share" },
            "rank": { "$ref": "#/definitions/rank" }
          }
        },
        "score": { "$ref": "#/definitions/share" },
        "leader": { "type": "boolean" },
        "qty": { "$ref": "#/definitions/qty" },
        "partnerCount": { "type": "integer", "minimum": 0 },
        "hhi": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/share" }] },
        "partners": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              { "$ref": "#/definitions/country" },
              { "$ref": "#/definitions/usd" },
              { "$ref": "#/definitions/share" }
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  }
}
