---
import { NAV, SITE, pagePath } from '../lib/site.js';

const current = pagePath(Astro.url);
const { lang } = Astro.props;
const isActive = (href) => current === href || current.startsWith(`${href}/`);
---
<nav id="top-navbar" aria-label="Main" lang={lang} class="sticky top-0 z-[1050] bg-darkbg/90 backdrop-blur-md border-b border-slate-800/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <a href="/" class="flex items-center gap-2.5">
        <img src="/favicon.svg" alt="" class="w-7 h-7" width="28" height="28">
        <span class="font-semibold text-base tracking-tight text-white">{SITE.name}</span>
      </a>

      <div class="hidden md:flex items-center space-x-8">
        {NAV.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}
            class:list={['font-medium text-sm transition hover:text-indigo-300', isActive(href) ? 'text-indigo-400' : 'text-slate-300']}>{label}</a>
        ))}
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="border border-slate-700 hover:border-slate-500 hover:bg-slate-800/80 text-slate-200 px-3.5 py-1.5 rounded-lg text-sm font-medium transition flex items-center gap-1.5">
          <span>GitHub</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="md:hidden flex items-center">
        <button id="mobile-menu-btn" type="button" class="text-slate-400 hover:text-white p-2 rounded-lg focus:outline-none" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-cardbg border-b border-slate-800 px-4 pt-2 pb-4 space-y-2">
    {NAV.map(({ href, label }) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined}
        class:list={['block py-2.5 hover:text-indigo-400', isActive(href) ? 'text-indigo-400' : 'text-slate-300']}>{label}</a>
    ))}
    <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="block text-center border border-slate-700 text-slate-200 py-2 rounded-lg mt-2 text-sm font-medium">GitHub ↗</a>
  </div>
</nav>
